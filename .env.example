PORT=3000

# Seller Central App ID (NOT the client id)
# Looks like: amzn1.sellerapps.app.xxxxxxxxxxxxx
AMAZON_SELLER_APP_ID=your_seller_app_id

# Login with Amazon (LWA) credentials from your Security Profile
LWA_CLIENT_ID=your_lwa_client_id
LWA_CLIENT_SECRET=your_lwa_client_secret

# Redirect URI registered in Security Profile
# Example: http://localhost:3000/auth/amazon/callback
OAUTH_REDIRECT_URI=http://localhost:3000/auth/amazon/callback

# Save this after OAuth callback step
LWA_REFRESH_TOKEN=your_lwa_refresh_token

# AWS IAM credentials used for SP-API request signing
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=eu-west-1

# Seller Central India marketplace ID
MARKETPLACE_ID=A21TJRUUN4KGV
